DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a random secret in production; local development generates one automatically.
# DJANGO_SECRET_KEY=
DB_ENGINE=sqlite
# Local admin creation and browser tests. Existing accounts are not reset.
DJANGO_ADMIN_USERNAME=
DJANGO_ADMIN_PASSWORD=
# DB_ENGINE=postgresql
# DB_NAME=civic
# DB_USER=civic
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DOCUMENT_MAX_BYTES=52428800
# Optional: cheie Google Gemini pentru generarea conversațională îmbunătățită a chatbot-ului
GEMINI_API_KEY= 

